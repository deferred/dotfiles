    refreshPeriod = "168h"
{{- if eq .chezmoi.os "darwin" }}

# AMO removed Profile Switcher for Firefox and its GitHub repo has no builds,
# so fetch the AMO-signed file from the Wayback Machine
["Library/Application Support/Mozilla/profile-switcher-ff@nd.ax.xpi"]
    type = "file"
    url = "https://web.archive.org/web/20250731192137id_/https://addons.mozilla.org/firefox/downloads/file/3945999/profile_switcher-1.3.1.xpi"
    checksum.sha256 = "80ca410ad883a0a2a2dc50cb1f74474dd829223ce106a5911120461c30e4e64f"
{{- end }}
