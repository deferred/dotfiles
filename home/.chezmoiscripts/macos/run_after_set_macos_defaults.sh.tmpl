#!/usr/bin/env bash

###############################################################################
# Keyboard                                                                    #
###############################################################################

# F1, F2, etc. behave as standard function keys
defaults write NSGlobalDomain com.apple.keyboard.fnState -bool true

# write a symbolic hotkey with typed values; old-style defaults syntax stores strings
symbolic_hotkey() {
	defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add "$1" \
		"<dict><key>enabled</key><$2/><key>value</key><dict><key>parameters</key><array><integer>$3</integer><integer>$4</integer><integer>$5</integer></array><key>type</key><string>standard</string></dict></dict>"
}

# Use Control-Space as the only input-source shortcut.
symbolic_hotkey 60 true 32 49 262144
symbolic_hotkey 61 false 32 49 786432

# free Command-Space for Raycast
symbolic_hotkey 64 false 32 49 1048576

# save a full-screen screenshot with Control-Command-Shift-3
symbolic_hotkey 28 true 51 20 1441792
# copy a full-screen screenshot with Command-Shift-3
symbolic_hotkey 29 true 51 20 1179648
# save a selected-area screenshot with Control-Command-Shift-4
symbolic_hotkey 30 true 52 21 1441792
# copy a selected-area screenshot with Command-Shift-4
symbolic_hotkey 31 true 52 21 1179648

# use native Mission Control shortcuts for Option+1 through Option+9
# use 65535 to match the physical key instead of the character it types
symbolic_hotkey 118 true 65535 18 524288
symbolic_hotkey 119 true 65535 19 524288
symbolic_hotkey 120 true 65535 20 524288
symbolic_hotkey 121 true 65535 21 524288
symbolic_hotkey 122 true 65535 23 524288
symbolic_hotkey 123 true 65535 22 524288
symbolic_hotkey 124 true 65535 26 524288
symbolic_hotkey 125 true 65535 28 524288
symbolic_hotkey 126 true 65535 25 524288

# Show the Input menu in the menu bar
defaults write com.apple.TextInputMenu visible -bool true

# Do not use the Caps Lock key to switch to and from Colemak
defaults write NSGlobalDomain TISRomanSwitchState -int 0

# Do not preserve a separate input source for each window or document.
defaults write com.apple.HIToolbox AppleGlobalTextInputProperties \
	-dict TextInputGlobalPropertyPerContextInput -bool false

# Do not correct spelling automatically
defaults write NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false
defaults write NSGlobalDomain WebAutomaticSpellingCorrectionEnabled -bool false

# Do not capitalize words automatically
defaults write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false

# Do not add a period with double-space
defaults write NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled -bool false

###############################################################################
# Menu Bar                                                                    #
###############################################################################

# Show Bluetooth in the menu bar
defaults -currentHost write com.apple.controlcenter Bluetooth -int 18

# Show battery percentage in the menu bar
defaults -currentHost write com.apple.controlcenter BatteryShowPercentage -bool true

# Show Weather in the menu bar
defaults write com.apple.weather menuBarEnabled -bool true

# Hide the Spotlight icon from the menu bar
defaults -currentHost write com.apple.Spotlight MenuItemHidden -int 1

# Set menu bar item order
defaults write com.apple.controlcenter "NSStatusItem Preferred Position Battery" -float 180
defaults write com.apple.controlcenter "NSStatusItem Preferred Position Bluetooth" -float 256
defaults write com.apple.controlcenter "NSStatusItem Preferred Position WiFi" -float 288
defaults write com.apple.TextInputMenuAgent "NSStatusItem Preferred Position Item-0" -float 326
defaults write com.apple.controlcenter "NSStatusItem Preferred Position FocusModes" -float 370
defaults write com.apple.weather.menu "NSStatusItem Preferred Position Item-0" -float 408

###############################################################################
# Displays                                                                    #
###############################################################################

# use CoreBrightness to avoid editing its root-owned preferences directly
/usr/bin/osascript -l JavaScript <<'EOF'
ObjC.import("Foundation");
const framework = $.NSBundle.bundleWithPath("/System/Library/PrivateFrameworks/CoreBrightness.framework");
if (!framework.load) throw new Error("Could not load CoreBrightness");

const client = $.NSClassFromString("CBBlueLightClient").alloc.init;
const sunsetToSunrise = 1;
if (!client.setMode(sunsetToSunrise)) throw new Error("Could not set the Night Shift schedule");
EOF

###############################################################################
# Dock                                                                        #
###############################################################################

# Automatically hide and show the Dock
defaults write com.apple.dock autohide -bool true

# Dock opening delay
defaults write com.apple.dock autohide-delay -float 0.1

# Animation time when hiding/showing the Dock
defaults write com.apple.dock autohide-time-modifier -float 0.2

# Don’t automatically rearrange Spaces based on most recent use
defaults write com.apple.dock mru-spaces -bool false

# Don’t show recent applications in Dock
defaults write com.apple.dock show-recents -bool false

# Show only open applications in the Dock
defaults write com.apple.dock static-only -bool true

# Disable bottom-right Quick Note hot corner
defaults write com.apple.dock wvous-br-corner -int 0
defaults write com.apple.dock wvous-br-modifier -int 0

# Set the icon size of Dock items
defaults write com.apple.dock tilesize -int 64

# Click wallpaper to reveal Desktop only in Stage Manager, needed for yabai
defaults write com.apple.WindowManager EnableStandardClickToShowDesktop -bool false

###############################################################################
# Finder                                                                      #
###############################################################################

# Avoid creating .DS_Store files on network or USB volumes
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true

# Show hidden files in Finder and application file dialogs
defaults write NSGlobalDomain AppleShowAllFiles -bool true
defaults write com.apple.finder AppleShowAllFiles -bool true

# When performing a search, search the current folder by default
defaults write com.apple.finder FXDefaultSearchScope -string "SCcf"

# Use list view in all Finder windows by default
# Four-letter codes for the other view modes: `icnv`, `clmv`, `glyv`
defaults write com.apple.finder FXPreferredViewStyle -string "Nlsv"

# Remove items from Trash after 30 days
defaults write com.apple.finder FXRemoveOldTrashItems -bool true

# Show path bar
defaults write com.apple.finder ShowPathbar -bool true

# Show status bar
defaults write com.apple.finder ShowStatusBar -bool true
#
# Show all filename extensions
defaults write NSGlobalDomain AppleShowAllExtensions -bool true

###############################################################################
# AutoFill                                                                    #
###############################################################################

# use 1Password for AutoFill, same as the toggle in System Settings > AutoFill & Passwords
pluginkit -e use -i com.1password.1password.autofill-extension

# set up verification codes in 1Password, same as "Set Up Codes In" in System Settings > AutoFill & Passwords
swift - <<'EOF'
import AppKit
let app = URL(fileURLWithPath: "/Applications/1Password.app")
NSWorkspace.shared.setDefaultApplication(at: app, toOpenURLsWithScheme: "otpauth") { _ in exit(0) }
RunLoop.main.run()
EOF

for app in \
	"ControlCenter" \
	"Dock" \
	"Finder" \
	"SystemUIServer" \
	"TextInputMenuAgent" \
	; \
do \
	killall "${app}" &> /dev/null
done

# reload symbolic hotkeys after all preferences are written
/System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u

open -g "/System/Applications/Weather.app/Contents/Library/LoginItems/WeatherMenu.app" &> /dev/null
