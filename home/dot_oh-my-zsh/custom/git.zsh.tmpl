alias fgco='git branch | fzf | xargs git checkout'
alias gstam='git stash push -m'

gclb() {
  if (( $# < 1 || $# > 2 )); then
    print 'usage: gclb <repository> [directory]'
    return 2
  fi

  local repository=$1
  local directory=${2:-${repository:t}}
  directory=${directory%/.git}
  directory=${directory%.git}
  local git_dir="$directory/.git"

  git clone --bare "$repository" "$git_dir" || return

  local default_branch
  default_branch=$(git --git-dir="$git_dir" symbolic-ref --short HEAD) || return

  git --git-dir="$git_dir" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*' &&
    git --git-dir="$git_dir" fetch origin &&
    git --git-dir="$git_dir" branch --set-upstream-to="origin/$default_branch" "$default_branch"
}

{{ if eq .chezmoi.os "darwin" -}}
alias gcaai='opencode run "/commit" > /dev/null 2>&1'
{{ end -}}
