#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "jsonc-edit==0.2.1",
#     "json5",
# ]
# ///
# chezmoi modify script for nono's opencode profile

import sys
from typing import Any

import json5
from jsonc_edit import edit_many, edit_session


JsonObject = dict[str, Any]
JsonPath = list[str]
Operation = tuple[JsonPath, Any]


# these grants use home-relative paths so they work on every machine
MANAGED_PATHS: dict[str, list[str]] = {
    "allow": [
        "~/.config/ccmux/session-pids",
        "~/.config/nono/profiles",
        "~/.jsonc-edit",
        "~/.local/share/gh",
    ],
    "read": [
        "~/.config/chezmoi",
        "~/.config/nono",
    ],
    # ~/.ssh is covered by deny_credentials, so each grant needs a matching bypass
    "read_file": [
        "~/.ssh/config",
        "~/.ssh/known_hosts",
    ],
    "bypass_protection": [
        "~/.ssh/config",
        "~/.ssh/known_hosts",
    ],
}

{{ if eq .chezmoi.os "darwin" -}}
# the ssh config sets IdentityAgent to this 1Password socket, so it needs a connect grant
ONEPASSWORD_AGENT_SOCKET = "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
MANAGED_PATHS["unix_socket"] = [ONEPASSWORD_AGENT_SOCKET]
MANAGED_PATHS["bypass_protection"].append(ONEPASSWORD_AGENT_SOCKET)

{{ end -}}

# remove obsolete or duplicate grants
REMOVED_PATHS: dict[str, list[str]] = {
    "read": [
        "~/.config/ccmux/session-pids",
        "~/.local/share",
    ],
}


def parse_source(source: str) -> JsonObject:
    value = json5.loads(source) if source.strip() else {}
    if not isinstance(value, dict):
        raise ValueError("nono profile must contain a JSON object")
    return value


def merged_paths(filesystem: JsonObject, name: str, paths: list[str]) -> list[Any]:
    current = filesystem.get(name, [])
    if not isinstance(current, list):
        current = []

    removed = REMOVED_PATHS.get(name, [])
    merged = [value for value in current if value not in removed]
    for path in paths:
        if path not in merged:
            merged.append(path)
    return merged


def path_operations(config: JsonObject) -> list[Operation]:
    filesystem = config.get("filesystem", {})
    if not isinstance(filesystem, dict):
        filesystem = {}

    return [
        (["filesystem", name], merged_paths(filesystem, name, paths))
        for name, paths in MANAGED_PATHS.items()
    ]


def main() -> None:
    source = sys.stdin.read() or "{}"
    config = parse_source(source)
    operations = path_operations(config)

    with edit_session():
        result = edit_many(source, operations)

    sys.stdout.write(result)


if __name__ == "__main__":
    main()
