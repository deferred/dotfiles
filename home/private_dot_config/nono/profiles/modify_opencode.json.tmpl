#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "jsonc-edit==0.2.1",
#     "json5",
# ]
# ///
# chezmoi modify script for nono's opencode profile

import sys
from typing import Any

import json5
from jsonc_edit import edit_many, edit_session


JsonObject = dict[str, Any]
JsonPath = list[str]
Operation = tuple[JsonPath, Any]


# these grants use home-relative paths so they work on every machine
MANAGED_PATHS: dict[str, list[str]] = {
    # write access only where tools must write; code that runs outside the sandbox stays read-only
    "allow": [
        "~/.config/ccmux/session-pids",
        "~/.jsonc-edit",
        "~/.local/share/gh",
        "~/.local/share/serena",
        "~/.local/share/zoxide",
        "~/.local/state/gh",
        # module cache and checksum db; ~/go/bin stays read-only via go_runtime
        "~/go/pkg",
    ],
    "read": [
        # chezmoi only needs read access for source-path, managed, cat and execute-template
        "~/.config/chezmoi",
        "~/.config/direnv",
        "~/.config/gh",
        "~/.config/nix",
        "~/.config/nono",
        "~/.config/rumdl",
        "~/.config/worktrunk",
        "~/.terraform.d/plugins",
    ],
    "read_file": [
        "~/.ssh/config",
        "~/.ssh/known_hosts",
    ],
    "bypass_protection": [
        "~/.ssh/config",
        "~/.ssh/known_hosts",
        "~/.terraform.d/plugins",
    ],
}

{{ if eq .chezmoi.os "darwin" -}}
MANAGED_PATHS["allow"].append("~/.Trash")

# the ssh config sets IdentityAgent to this 1Password socket, so it needs a connect grant
ONEPASSWORD_AGENT_SOCKET = "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
MANAGED_PATHS["unix_socket"] = [ONEPASSWORD_AGENT_SOCKET]
MANAGED_PATHS["bypass_protection"].append(ONEPASSWORD_AGENT_SOCKET)

{{ end -}}

MANAGED_GROUPS: list[str] = [
    "go_runtime",
]

# the go-build caches are already writable through the pack's user_caches_* groups
REMOVED_GROUPS: list[str] = [
    "go_runtime_linux",
    "go_runtime_macos",
]

# uvx needs a writable tool dir, so give it a sandbox-only one instead of ~/.local/share/uv/tools
MANAGED_ENV: dict[str, str] = {
    "UV_TOOL_DIR": "$HOME/.cache/opencode/uv-tools",
}

# remove obsolete, duplicate or unsafe grants
REMOVED_PATHS: dict[str, list[str]] = {
    "allow": [
        # lets the agent change its own sandbox
        "~/.config/nono/profiles",
        # holds chezmoi data and hooks that run outside the sandbox
        "~/.config/chezmoi",
        # tools and binaries here run outside the sandbox
        "~/.local/share/uv",
        "~/.terraform.d",
        "~/go",
    ],
    "read": [
        "~/.config/ccmux/session-pids",
        "~/.kube",
        "~/.local/share",
    ],
    "bypass_protection": [
        "~/.kube",
        "~/.terraform.d",
    ],
}


def parse_source(source: str) -> JsonObject:
    value = json5.loads(source) if source.strip() else {}
    if not isinstance(value, dict):
        raise ValueError("nono profile must contain a JSON object")
    return value


def merged_paths(filesystem: JsonObject, name: str, paths: list[str]) -> list[Any]:
    current = filesystem.get(name, [])
    if not isinstance(current, list):
        current = []

    removed = REMOVED_PATHS.get(name, [])
    merged = [value for value in current if value not in removed]
    for path in paths:
        if path not in merged:
            merged.append(path)
    return sorted(merged, key=str)


def path_operations(config: JsonObject) -> list[Operation]:
    filesystem = config.get("filesystem", {})
    if not isinstance(filesystem, dict):
        filesystem = {}

    operations = [
        (["filesystem", name], merged_paths(filesystem, name, paths))
        for name, paths in MANAGED_PATHS.items()
    ]

    groups = config.get("groups", {})
    if not isinstance(groups, dict):
        groups = {}
    included = groups.get("include", [])
    if not isinstance(included, list):
        included = []
    included = [group for group in included if group not in REMOVED_GROUPS]
    for group in MANAGED_GROUPS:
        if group not in included:
            included.append(group)
    operations.append((["groups", "include"], included))

    operations.extend(
        (["environment", "set_vars", name], value) for name, value in MANAGED_ENV.items()
    )
    return operations


def main() -> None:
    source = sys.stdin.read() or "{}"
    config = parse_source(source)
    operations = path_operations(config)

    with edit_session():
        result = edit_many(source, operations)

    sys.stdout.write(result)


if __name__ == "__main__":
    main()
