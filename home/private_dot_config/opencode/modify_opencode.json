#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "jsonc-edit==0.2.1",
#     "json5",
# ]
# ///
# chezmoi modify script for opencode.json
# Applies managed settings to the existing file, preserving machine-local config and comments.

import sys
from collections.abc import Iterator
from typing import Any

import json5
from jsonc_edit import edit_many, edit_session


JsonObject = dict[str, Any]
JsonPath = list[str]
Operation = tuple[JsonPath, Any]


# Settings managed by chezmoi. All other values remain machine-local.
MANAGED_SETTINGS: JsonObject = {
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "context7": {
            "type": "local",
            "command": ["npx", "-y", "@upstash/context7-mcp"],
        }
    },
    "agent": {
        "fast": {
            "mode": "subagent",
        }
    },
    "permission": {
        "external_directory": {
            "/tmp/**": "allow",
        },
        "websearch": "allow",
    },
}


def leaf_operations(value: Any, path: JsonPath | None = None) -> Iterator[Operation]:
    """Flatten settings into source-preserving edits for each managed leaf."""
    current_path = path or []
    if isinstance(value, dict):
        for key, child in value.items():
            yield from leaf_operations(child, [*current_path, key])
        return

    yield current_path, value


def validate_source(source: str) -> None:
    try:
        current = json5.loads(source)
    except Exception as exc:
        print(f"cannot parse opencode.json: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc

    if not isinstance(current, dict):
        print("opencode.json must contain a JSON object", file=sys.stderr)
        raise SystemExit(1)


def main() -> None:
    source = sys.stdin.read() or "{}"
    operations = list(leaf_operations(MANAGED_SETTINGS))
    validate_source(source)

    try:
        with edit_session():
            result = edit_many(source, operations)
    except Exception as exc:
        print(f"cannot edit opencode.json: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc

    sys.stdout.write(result)


if __name__ == "__main__":
    main()
