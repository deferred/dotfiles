#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///

import os
import re
import shutil
import subprocess
import sys
import tempfile

SETTINGS = {
    "project_serena_folder_location": "'{{ .chezmoi.homeDir }}/.local/share/serena/projects/$projectFolderName/.serena'",
    "web_dashboard_open_on_launch": "false",
    "web_dashboard_interface": "browser",
}

def generate_default_config() -> str:
    executable = shutil.which("serena")
    if executable is None:
        raise FileNotFoundError("Serena is required to create its default config")
    with tempfile.TemporaryDirectory() as home:
        env = os.environ.copy()
        env["SERENA_HOME"] = home
        try:
            subprocess.run(
                [executable, "init"],
                env=env,
                check=True,
                capture_output=True,
                text=True,
            )
        except subprocess.CalledProcessError as error:
            raise RuntimeError(f"serena init failed: {error.stderr.strip()}") from error
        config_path = os.path.join(home, "serena_config.yml")
        with open(config_path, encoding="utf-8") as file:
            result = file.read()
        if not result.strip():
            raise ValueError("serena init generated an empty config")
        return result


def main() -> None:
    existing = sys.stdin.read()
    result = existing if existing.strip() else generate_default_config()

    for key, value in SETTINGS.items():
        setting = f"{key}: {value}"
        pattern = re.compile(rf"^{re.escape(key)}:.*$", re.MULTILINE)
        result, replacements = pattern.subn(setting, result, count=1)
        if replacements == 0:
            separator = "" if not result or result.endswith("\n") else "\n"
            result = f"{result}{separator}{setting}\n"
    sys.stdout.write(result)


if __name__ == "__main__":
    main()
